SD_PLATFORM_HOST=127.0.0.1
SD_PLATFORM_PORT=4100
SD_PLATFORM_DATA_PROVIDER=local
SD_PLATFORM_DATA_FILE=backend/platform/data/dev-db.json
SD_PLATFORM_ADMIN_KEY=dev-admin-key

# Optional AI proxy
SD_PLATFORM_AI_PROXY_URL=http://127.0.0.1:8000/chat
SD_PLATFORM_TRANSLATION_PROXY_URL=http://127.0.0.1:8000/translate

# Optional email delivery
SD_PLATFORM_EMAIL_PROVIDER=resend
SD_PLATFORM_RESEND_API_KEY=re_xxxxxxxxx
SD_PLATFORM_EMAIL_FROM=SD Travel Guide <noreply@yourdomain.com>
SD_PLATFORM_APP_NAME=SD Travel Guide
